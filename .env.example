# ===== 1. 首次部署：填写自己的官方 Sub2API 根地址 =====
# 不要添加 /api 或 /api/v1 后缀。完整步骤见 README.md。
FASTAIAPI_BASE_URL=https://fastaiapi.cloud

# ===== 2. 本扩展的容器名称、端口与独立数据库 =====
# 已产生数据后，不要随意更改项目名和数据库账号密码。
SUB_ADDS_NAME=fastaidesign
SUB_ADDS_FRONTEND_PORT=4445
SUB_ADDS_BACKEND_PORT=4455
POSTGRES_DB=sub_adds
POSTGRES_USER=sub_adds
# 首次启动前替换 change-me，建议使用较长的英文字母和数字组合。
POSTGRES_PASSWORD=change-me

# ===== 3. 自动充值：不用充值时保持 false，下面信息可以暂不填写 =====
RECHARGE_ENABLED=false
# 用户访问的主站 HTTPS 根地址，不包含 /fastaiui 或 /fastaiapi。
RECHARGE_PUBLIC_URL=https://your-domain.example
RECHARGE_GATEWAY=https://pay.1kexiu.xyz
RECHARGE_PID=
# 使用商户的支付对接密钥，不是登录密码或挂机软件密钥。
RECHARGE_KEY=

# 必须连接官方 Sub2API 实际使用的 PostgreSQL / Redis，不是上面本扩展的新数据库。
# 以下地址只是格式示例，需要按实际网络、容器名、TLS 设置和账号密码修改。
# Docker 内网互联方式见 README；容器里的 localhost 指向自身。
SUB2API_DATABASE_URL=postgres://recharge:password@sub2api-postgres:5432/sub2api?sslmode=disable
# 末尾 /0 是 Redis 数据库编号，必须与官方配置一致。
SUB2API_REDIS_URL=redis://:password@sub2api-redis:6379/0

# 可选：留空使用八档默认套餐，默认支付人民币数字与到账 USD 数字相同。
# amount_cents 单位为人民币分，credit 是到账 USD 额度；此例为支付 70 元、到账 10 USD。
# RECHARGE_PACKAGES='[{"id":"starter","name":"10 刀额度","amount_cents":7000,"credit":"10"}]'

# ===== 4. 可选的异常告警：不配置时仍可在充值管理页查看 =====
# 接收地址需为 HTTPS；接收端按 (issue_id, generation) 去重。
RECHARGE_ALERT_WEBHOOK_URL=
RECHARGE_ALERT_TOKEN=
